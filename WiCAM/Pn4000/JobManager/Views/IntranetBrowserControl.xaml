<UserControl x:Class="WiCAM.Pn4000.JobManager.Views.IntranetBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Navigation Bar -->
        <Border Grid.Row="0" Background="#FF2D2D30" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Buttons -->
                <Button x:Name="btnBack" Grid.Column="0" Width="32" Height="32" Margin="2" 
                        Click="BtnBack_Click" ToolTip="Zurueck">
                    <Path Data="M15,4 L5,14 L15,24" Stroke="White" StrokeThickness="2" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <Button x:Name="btnForward" Grid.Column="1" Width="32" Height="32" Margin="2" 
                        Click="BtnForward_Click" ToolTip="Vorwaerts">
                    <Path Data="M5,4 L15,14 L5,24" Stroke="White" StrokeThickness="2" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <Button x:Name="btnRefresh" Grid.Column="2" Width="32" Height="32" Margin="2" 
                        Click="BtnRefresh_Click" ToolTip="Aktualisieren">
                    <Path Data="M12,4 A8,8 0 1,1 4,12 M12,4 L12,8 M12,4 L8,4" 
                          Stroke="White" StrokeThickness="2" Fill="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <Button x:Name="btnHome" Grid.Column="3" Width="32" Height="32" Margin="2" 
                        Click="BtnHome_Click" ToolTip="Startseite">
                    <Path Data="M8,2 L14,8 L14,18 L10,18 L10,12 L6,12 L6,18 L2,18 L2,8 Z" 
                          Stroke="White" StrokeThickness="1" Fill="White"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- URL TextBox -->
                <Border Grid.Column="4" Background="White" CornerRadius="3" Margin="5,2">
                    <TextBox x:Name="txtUrl" BorderThickness="0" Padding="5,5"
                             VerticalContentAlignment="Center"
                             KeyDown="TxtUrl_KeyDown"/>
                </Border>

                <!-- Go Button -->
                <Button x:Name="btnGo" Grid.Column="5" Width="60" Height="32" Margin="2" 
                        Content="Los" Click="BtnGo_Click" 
                        Background="#FF007ACC" Foreground="White" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- WebView Container -->
        <Grid x:Name="gridWebView" Grid.Row="1" Background="White">
            <!-- WebView2 wird hier programmatisch hinzugef�gt -->
        </Grid>

        <!-- Progress Bar -->
        <ProgressBar x:Name="progressBar" Grid.Row="2" Height="3" 
                     IsIndeterminate="True" Visibility="Collapsed"
                     Foreground="#FF007ACC"/>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#FF2D2D30" Padding="5" Height="24">
            <TextBlock x:Name="txtStatus" Foreground="White" 
                       VerticalAlignment="Center" FontSize="11"
                       Text="Bereit"/>
        </Border>
    </Grid>
</UserControl>